{
  "name": "@terpatin/pintaliiskain",
  "version": "1.0.1",
  "description": "https://github.com/HannulaTero/PintaLiiskain \r\nhttps://terohannula.itch.io/pintaliiskain \r\nThis library allows reducing given input all the way into 1x1 surface. The asset generates and keeps the midsteps alive, so you may also refer to them. You may reduce the surface by \"average\", \"maximum\", \"minimum\" or \"summation\". If you use regular rgba8unorm format, there can be quantization error with averaging, but should work. For summation you need to use float-textures! Use example is to generate mipmapping by using average-reducer, and then getting all results in one surface with \"GetMap\"",
  "files": [
    "com.terpatin.pintaliiskain-1.0.1.yymps"
  ],
  "keywords": [
    "shader",
    "surface",
    "reduce"
  ],
  "author": "Terpatin",
  "license": "C:\\Users\\tero_\\files\\github\\MIT License 2026 Tero Hannula.txt",
  "gm": {
    "destination": "terpatin/pintaliiskain",
    "icon": {
      "mime": "image/png",
      "data": ""
    },
    "displayName": "PintaLiiskain",
    "shortDescription": "Surface reducer",
    "visible": true,
    "ide_versions": {
      "LTS": ">=2026.100.0"
    },
    "supportedArchitecture": "any",
    "removeDependenciesOnUninstall": "always",
    "notifyOfUpdates": true,
    "requiresRestart": false
  }
}